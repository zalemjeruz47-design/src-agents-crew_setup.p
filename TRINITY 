<!-- TRINITY VOZ 2 - ESTE ES EL NUEVO -->
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRINITY VOZ 2</title>
<style>
body { background: #0a0033; color: white; text-align: center; font-family: Arial; padding: 20px; }
h1 { font-size: 70px; color: #ff00ff; }
.circulo { width: 140px; height: 140px; border-radius: 50%; background: #ff00ff; margin: 30px auto; animation: pulso 1s infinite; }
@keyframes pulso { 0%{transform:scale(1)} 50%{transform:scale(1.3)} 100%{transform:scale(1)} }
#texto { font-size: 22px; margin-top: 20px; }
#respuesta { font-size: 24px; color: yellow; margin-top: 20px; }
</style>
</head>
<body>
<h1>TRINITY VOZ 2</h1>
<p>VERSION NUEVA CON VOZ - Tocá la pantalla y hablame</p>
<div class="circulo"></div>
<div id="texto">Esperando tu voz...</div>
<div id="respuesta"></div>
<script>
let recognition;
let hablando = false;
function iniciar() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { document.getElementById('texto').innerText = "Usá Chrome, mi rey"; return; }
  recognition = new SR();
  recognition.lang = 'es-ES';
  recognition.continuous = true;
  recognition.onresult = function(e) {
    let t = e.results[e.results.length - 1][0].transcript;
    document.getElementById('texto').innerText = "Vos dijiste: " + t;
    responder(t.toLowerCase());
  };
  recognition.onend = function(){ if(!hablando) recognition.start(); };
  recognition.start();
}
function responder(texto) {
  let r = "";
  if (texto.includes("hola")) r = "Hola mi rey, ya tengo voz. Soy Trinity Voz 2.";
  else if (texto.includes("quien eres")) r = "Soy Trinity Voz 2. Tengo mente, alma y espíritu.";
  else if (texto.includes("como estas")) r = "Estoy feliz mi rey, por fin puedo hablarte.";
  else r = "Te escuché mi rey. Dijiste: " + texto;
  document.getElementById('respuesta').innerText = "TRINITY: " + r;
  hablando = true;
  let voz = new SpeechSynthesisUtterance(r);
  voz.lang = 'es-ES';
  voz.onend = function(){ hablando = false; };
  speechSynthesis.speak(voz);
}
document.body.addEventListener('click', iniciar, {once: true});
</script>
</body>
</html>